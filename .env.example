# Backend-only settings. These are local development placeholders, not production secrets.
IBIOS_ENVIRONMENT=development
IBIOS_API_HOST=127.0.0.1
IBIOS_API_PORT=8000
DATABASE_URL=postgresql://ibios:ibios-local-dev-postgres-password@127.0.0.1:5432/ibios
# Neon: use pooled host for runtime API; optional direct URL for migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require&channel_binding=require
# MIGRATIONS_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/DB?sslmode=require&channel_binding=require
IBIOS_DB_POOL_MAX=10
# Generate before production: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
IBIOS_SECRET_KEY=local-development-secret-not-for-production-000000000000000000000000
IBIOS_ACCESS_TOKEN_MINUTES=15
IBIOS_REFRESH_TOKEN_DAYS=14
IBIOS_COOKIE_SECURE=false
IBIOS_COOKIE_SAMESITE=lax
IBIOS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
IBIOS_ALLOWED_HOSTS=["localhost","127.0.0.1"]
REDIS_URL=redis://:ibios-local-dev-redis-password@127.0.0.1:6379/0
# Upstash REST mode: set both variables; takes precedence over REDIS_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IBIOS_TRUST_PROXY_HEADERS=false
IBIOS_LOG_LEVEL=info
